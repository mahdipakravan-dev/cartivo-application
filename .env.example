# آدرس داخلی بک‌اند Spring Boot (فقط سمت سرور)
API_BASE_URL=http://localhost:8080

# آدرس عمومی API برای درخواست‌های سمت مرورگر
NEXT_PUBLIC_API_BASE_URL=

# دامنه‌ی اصلی سایت (canonical ،sitemap و اسکیما) — بدون اسلش انتهایی
NEXT_PUBLIC_SITE_URL=https://cartivo.ir

# تأیید مالکیت با متاتگ (اختیاری؛ روش DNS در Search Console ترجیح دارد)
# مقدار content متاتگ google-site-verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# مقدار content متاتگ msvalidate.01 در Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=
